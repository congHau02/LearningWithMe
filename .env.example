# Database (MySQL 8.0) — replace all change_me_* secrets before enabling prod
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=studytogether
MYSQL_USER=studyuser
MYSQL_PASSWORD=change_me_db_password
MYSQL_PORT=3306

# Cache & Hot State (Redis 7 with AOF persistence)
REDIS_PORT=6379

# Service Ports (Render injects PORT dynamically; local dev defaults to BACKEND_PORT=8080)
PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Spring Boot Backend Configuration
# Set SPRING_PROFILES_ACTIVE=prod in production (forwarded headers, JSON logs, health-only actuator, strict env vars)
SPRING_PROFILES_ACTIVE=
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/studytogether?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=studyuser
SPRING_DATASOURCE_PASSWORD=change_me_db_password
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=5
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false
APP_JWT_SECRET=change_me_jwt_secret_at_least_32_bytes_long_for_hmac_sha256
APP_STORAGE_HOMEWORK_DIR=/tmp/homework-uploads
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_AUTH_RATE_LIMIT_MAX_REQUESTS=10
APP_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
GOOGLE_CLIENT_ID=
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
# Managed TURN Free Tier / TURN REST API (HMAC-SHA1 short-lived credentials for /api/v1/voice/ice-servers)
APP_VOICE_TURN_URLS=
APP_VOICE_TURN_SECRET=
APP_VOICE_TURN_TTL_SECONDS=3600

# React Vite Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
# Optional explicit WebSocket URL (derived from VITE_API_BASE_URL as ws(s)://.../ws when omitted)
VITE_WS_BASE_URL=
VITE_GOOGLE_CLIENT_ID=

# Production Multi-Cloud PaaS (Render Free + Vercel) & Optional SSH Fallback (docker-compose.prod.yml)
BACKEND_PUBLIC_URL=
RENDER_DEPLOY_HOOK_URL=
DUCKDNS_DOMAIN=
BACKEND_IMAGE=ghcr.io/conghau02/study-together-backend:latest
