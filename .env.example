# Database (MySQL 8.0)
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=studytogether
MYSQL_USER=studyuser
MYSQL_PASSWORD=change_me_db_password
MYSQL_PORT=3306

# Cache & Hot State (Redis 7)
REDIS_PORT=6379

# Service Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Spring Boot Backend Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/studytogether?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=studyuser
SPRING_DATASOURCE_PASSWORD=change_me_db_password
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
APP_JWT_SECRET=change_me_jwt_secret_at_least_32_bytes_long_for_hmac_sha256
APP_STORAGE_HOMEWORK_DIR=/tmp/homework-uploads
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# React Vite Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
